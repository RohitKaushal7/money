# money — production environment (single-container deploy)
#
# Copy this to `.env` in the same directory as docker-compose.yml (e.g. ~/apps/money/.env). BOTH values
# below are now OPTIONAL — a fresh install boots with an empty .env (or none at all). NODE_ENV and
# DATA_DIR are baked into docker-compose.yml, and CORS_ORIGIN is not needed in prod (web and API share
# one origin).
#
# This file is committed as a template. The real `.env` is never committed and never rsynced.

# OPTIONAL. 32+ character secret for Better-Auth sessions. If left unset, the entrypoint generates one on
# first boot and persists it at $DATA_DIR/auth-secret (inside your ./data volume), so sessions survive
# restarts. Set it explicitly only if you want to control the value. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# OPTIONAL. The origin the browser uses to reach the app, no trailing slash. Defaults to
# http://localhost:3000. Set this ONLY if you reach the app from another origin — a LAN IP, or a domain
# behind a reverse proxy (which you also handle TLS for). Example:
#   https://money.example.com
BETTER_AUTH_URL=
