# money — production environment (single-container deploy)
#
# Copy this to `.env` in the same directory as docker-compose.yml on the server (e.g. ~/apps/money/.env)
# and fill in both values. These are the ONLY two you set; NODE_ENV and DATA_DIR are baked into
# docker-compose.yml, and CORS_ORIGIN is not needed in prod (web and API share one origin).
#
# This file is committed as a template. The real `.env` is never committed and never rsynced.

# 32+ character random secret for Better-Auth. Generate once on the server:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public HTTPS origin your reverse proxy serves, no trailing slash. Example:
#   https://money.example.com
BETTER_AUTH_URL=
