{
	"name": "money",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6",
			"@types/bun": "^1.3.14",
			"hono": "^4.12.27",
			"@orpc/server": "^1.14.6",
			"@orpc/openapi": "^1.14.6",
			"@orpc/zod": "^1.14.6",
			"better-auth": "1.6.23",
			"lucide-react": "^1.23.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"sonner": "^2.0.7",
			"@orpc/client": "^1.14.6",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.2"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F server",
		"db:studio": "turbo run db:studio -F @money/db",
		"db:generate": "turbo run db:generate -F @money/db",
		"db:migrate": "bun scripts/migrate-db.ts",
		"db:local": "turbo run db:local -F @money/db",
		"ingest": "bun run scripts/ingest.ts",
		"cutover": "bun scripts/migrate-to-multiuser.ts",
		"cards:import": "DATABASE_URL=file:./local.db bun --env-file=apps/server/.env scripts/cards-import.ts",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@money/analytics": "workspace:*",
		"@money/db": "workspace:*",
		"@money/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"yaml": "^2.9.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@money/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.10.2",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.0"
}
